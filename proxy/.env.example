# Copy to .env and fill in before deploying. .env must never be committed.

# Port the proxy listens on (platforms like Render/Railway inject their own).
PORT=8787

# REQUIRED: the exact origin of your public frontend, e.g. https://ledger.example.com
# CORS is opened to this origin only. Never use "*".
ALLOWED_ORIGIN=

# Upstream Firsto API bases (defaults are the production endpoints).
FIRSTO_BSC_API=https://api-tapeout.firsto.ai
FIRSTO_XLAYER_API=https://xlayer-api-tapeout.firsto.ai

# Per-IP rate limit for upstream queries, per minute. /health and /api/cases are exempt.
RATE_LIMIT_PER_MIN=10

# Path to the anonymized case file served at /api/cases (default: ../cases.json).
CASES_FILE=../cases.json

# How often cases.json is re-read from disk, in ms (default 1 hour).
CASES_REFRESH_MS=3600000

# Upstream request timeout in ms.
UPSTREAM_TIMEOUT_MS=15000

# Set to 1 when running behind a platform proxy so rate limiting keys on X-Forwarded-For.
TRUST_PROXY=0
